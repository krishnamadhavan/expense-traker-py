# Copy to backend/.env for local development (never commit .env)

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (start with: make db-up)
# Host is localhost when the API runs on the host and Postgres is in Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=expense_tracker
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# Comma-separated origins for the React app (local defaults applied in local.py if empty)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Production-only examples (use config.settings.production)
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# POSTGRES_HOST=db.example.com
